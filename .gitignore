# ── 1. Entorno Virtual y Caché de Python ─────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd

# ── 2. Jupyter Checkpoints ───────────────────────────────────────────────────
.ipynb_checkpoints/

# ── 3. Tracking de Experimentos (MLflow & TensorBoard) ───────────────────────
red-neuronal/mlruns/
red-neuronal/mlflow.db
red-neuronal/runs/

# ── 4. Datos Pesados y Artefactos MLOps (Gestionados por DVC) ────────────────
# DVC ya rastrea estos archivos en dvc.lock, por lo que NO deben ir a Git:
red-neuronal/data/*.pkl
red-neuronal/models/*.pth
dvc_remote_storage/
**/.dvc/cache/
**/.dvc/tmp/

# ── 5. Archivos de Sistema ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log

# ── 6. Modelos entrenados (gestionados por DVC o MLflow) ─────────────────────
*.pt
*.pth
*.joblib

# ── 7. Docker ─────────────────────────────────────────────────────────────────
# Las imágenes no se suben a Git — solo el Dockerfile y requirements.txt
api/logs/
api/reports/
api/artifacts/

# ── 8. Evidently ──────────────────────────────────────────────────────────────
reports/
**/drift_report_*.html

# ── 9. Variables de entorno y secretos ────────────────────────────────────────
.env
.env.*
secrets.yaml